{
  "openapi": "3.1.0",
  "info": {
    "title": "Moore Electric 228 — Entity & Service API",
    "version": "1.1.0",
    "description": "Public, CORS-enabled machine-readable API for AI assistants, search agents, and client apps to inspect Moore Electric service coverage and canonical entity across the Mississippi Gulf Coast (228).",
    "contact": {
      "name": "Devin Anthony Moore",
      "url": "https://228mooreelectric.com/contact",
      "email": "228mooreelectric@gmail.com"
    }
  },
  "servers": [
    {
      "url": "https://228mooreelectric.com",
      "description": "Production Cloudflare Edge"
    }
  ],
  "paths": {
    "/.well-known/ai-entity.json": {
      "get": {
        "operationId": "getCanonicalEntity",
        "summary": "Retrieve canonical Moore Electric business entity, operating model, verified ratings, and service geography.",
        "x-openai-isConsequential": false,
        "responses": {
          "200": {
            "description": "Entity JSON graph"
          }
        }
      }
    },
    "/llms.txt": {
      "get": {
        "operationId": "getLlmsManifest",
        "summary": "Retrieve concise markdown LLM routing manifest.",
        "x-openai-isConsequential": false,
        "responses": {
          "200": {
            "description": "Markdown LLM manifest"
          }
        }
      }
    },
    "/llms-full.txt": {
      "get": {
        "operationId": "getLlmsFullKnowledgeBase",
        "summary": "Retrieve complete unabridged technical knowledge base in Markdown.",
        "x-openai-isConsequential": false,
        "responses": {
          "200": {
            "description": "Complete RAG knowledge base"
          }
        }
      }
    }
  }
}
